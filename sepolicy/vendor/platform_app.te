allow platform_app sysfs_kgsl:dir search;

# touchkeypad stuffs
allow platform_app default_android_service:service_manager find;
set_prop(platform_app, vendor_touchkeypad_prop)

# KEY2 CPU Boost QS
set_prop(platform_app, vendor_cpuboost_prop)

# KEY2 BoomSound QS
set_prop(platform_app, vendor_boomsound_prop)
